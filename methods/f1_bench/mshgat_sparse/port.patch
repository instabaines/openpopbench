@@ -0,0 +1,25 @@
+"""Numerical equivalence of the sparse MS-HGAT port and the released dense code (legacy Twitter, train-only hypergraphs)."""
+import importlib, os, sys
+import numpy as np, torch
+sys.argv = [sys.argv[0], "-data_name", "twitter"]
+import Constants
+from dataLoader import Split_data, DataLoader
+from graphConstruct import ConHyperGraphList, ConRelationGraph
+from sparse_ops import ConHyperGraphListSparse
+import HGAT as H
+
+class O: pass
+opt = O(); opt.d_word_vec = opt.d_model = 64; opt.initialFeatureSize = 64
+user_size, cas, ts, train, valid, test = Split_data("twitter", 0.8, 0.1, load_dict=True); opt.user_size = user_size
+tr = set(train[2]); hc = [c if i in tr else [Constants.EOS] for i, c in enumerate(cas)]; ht = [t if i in tr else [Constants.EOS] for i, t in enumerate(ts)]
+dense = ConHyperGraphList(hc, ht, user_size); sparse = ConHyperGraphListSparse(hc, ht, user_size)
+print("slice keys equal:", list(dense[0].keys()) == list(sparse[0].keys()))
+print("incidence equal per slice:", all(torch.equal(dense[0][k].float(), sparse[0][k].to_dense().float()) for k in dense[0]))
+graph = ConRelationGraph("twitter")
+torch.manual_seed(0); H.SPARSE = False; md = H.MSHGAT(opt, dropout=0.3).cuda().eval()
+H.SPARSE = True; ms = H.MSHGAT(opt, dropout=0.3).cuda().eval(); ms.load_state_dict(md.state_dict())
+batch = next(iter(DataLoader(test, batch_size=32, cuda=False)))
+with torch.no_grad():
+    yd = md(*[b.cuda() for b in batch], graph, dense); ys = ms(*[b.cuda() for b in batch], graph, sparse)
+d = (yd - ys).abs(); print(f"MSHGAT output max |diff| {float(d.max()):.3e}, rel {float(d.max() / yd.abs().max()):.3e}")
+print("top-100 identical for", float((yd.topk(100).indices == ys.topk(100).indices).float().mean()), "of positions")
