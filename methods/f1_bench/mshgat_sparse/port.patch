@@ -0,0 +1,87 @@
+"""Exact sparse port of the MS-HGAT hypergraph layer and hypergraph construction (memory O(nnz) instead of O(users x cascades)).
+
+The released HGATLayer applies F.softmax to rows of a DENSE binary incidence matrix A (R x C). For a binary row with k ones,
+softmax gives weight e/(k e + C - k) to members and 1/(k e + C - k) to non-members, so
+
+    softmax(A, dim=1) @ X  =  (1^T X + (e - 1) A X) / (C + (e - 1) k)        (row-wise),
+
+which is computed here with a sparse A. This is an identity, not an approximation; test_equiv.py checks it against the
+released dense code. Consequence of the released design: every non-member receives nonzero weight, so for large C the
+aggregation approaches the global mean of X.
+"""
+import math
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from torch.nn.parameter import Parameter
+
+E1 = math.e - 1.0
+
+
+def soft_rowmix(A, X):
+    """softmax(dense(A), dim=1) @ X for a sparse binary A [R, C] and dense X [C, d]."""
+    C = A.shape[1]
+    k = torch.sparse.sum(A, 1).to_dense() if A._nnz() else torch.zeros(A.shape[0], device=X.device)
+    AX = torch.sparse.mm(A, X)
+    return (X.sum(0, keepdim=True) + E1 * AX) / (C + E1 * k).unsqueeze(1)
+
+
+class SparseHGATLayer(nn.Module):
+    """Same parameters and forward as layer.HGATLayer, with adj a sparse binary COO tensor [users, hyperedges]."""
+
+    def __init__(self, in_features, out_features, dropout, transfer, concat=True, bias=False, edge=True):
+        super().__init__()
+        self.dropout, self.in_features, self.out_features, self.concat, self.edge, self.transfer = dropout, in_features, out_features, concat, edge, transfer
+        if self.transfer: self.weight = Parameter(torch.Tensor(in_features, out_features))
+        else: self.register_parameter("weight", None)
+        self.weight2 = Parameter(torch.Tensor(in_features, out_features))
+        self.weight3 = Parameter(torch.Tensor(out_features, out_features))
+        if bias: self.bias = Parameter(torch.Tensor(out_features))
+        else: self.register_parameter("bias", None)
+        self.reset_parameters()
+
+    def reset_parameters(self):
+        stdv = 1. / math.sqrt(self.out_features)
+        if self.weight is not None: self.weight.data.uniform_(-stdv, stdv)
+        self.weight2.data.uniform_(-stdv, stdv); self.weight3.data.uniform_(-stdv, stdv)
+        if self.bias is not None: self.bias.data.uniform_(-stdv, stdv)
+
+    def forward(self, x, adj, root_emb):
+        x = x.matmul(self.weight) if self.transfer else x.matmul(self.weight2)
+        if self.bias is not None: x = x + self.bias
+        adjT = adj.t().coalesce()
+        edge = soft_rowmix(adjT, x)                                   # = softmax(adj.T, 1) @ x
+        edge = F.relu(F.dropout(edge, self.dropout, training=self.training))
+        e1 = edge.matmul(self.weight3)
+        node = F.dropout(soft_rowmix(adj, e1), self.dropout, training=self.training)   # = softmax(adj, 1) @ e1
+        if self.concat: node = F.relu(node)
+        if self.edge:
+            edge = F.relu(F.dropout(soft_rowmix(adjT, node), self.dropout, training=self.training))
+            return node, edge
+        return node
+
+
+def ConHyperGraphListSparse(cascades, timestamps, user_size, step_split=8):
+    """Same slices as graphConstruct.ConHyperGraphList, returned as sparse binary COO tensors [user_size, n_cascades + 1]."""
+    rows, cols, vals, root_list = [], [], [], [0]
+    for i, (c, t) in enumerate(zip(cascades, timestamps)):
+        root_list.append(c[0]); rows += c[:-1]; cols += [i + 1] * (len(c) - 1); vals += t[:-1]
+    E = len(cascades) + 1
+    # The released code builds a dense matrix with to_dense(), which SUMS the times of duplicate (user, cascade) entries;
+    # a summed time then falls outside every slice. Reproduced exactly: coalesce (sum) duplicates before slicing.
+    # Benchmark tables hold first participations only, so duplicates cannot occur there.
+    T = torch.sparse_coo_tensor(torch.tensor([rows, cols]), torch.tensor(vals, dtype=torch.float32), [user_size, E]).coalesce()
+    rows, cols, vals = T.indices()[0], T.indices()[1], T.values()
+    time_sorted = []
+    for t in timestamps: time_sorted += t[:-1]
+    time_sorted = sorted(time_sorted); L = len(time_sorted) // step_split
+    vt = vals.float()   # the released code compares float32 times (torch.Tensor), reproduced here
+    graph_list = {}
+    for x in range(L, L * step_split, L):
+        hi = torch.tensor(time_sorted[x], dtype=torch.float32)
+        lo = torch.tensor(0.0) if x == L else torch.tensor(time_sorted[x - L], dtype=torch.float32)
+        m = (vt > lo) & (vt <= hi)
+        idx = torch.stack([rows[m], cols[m]])
+        A = torch.sparse_coo_tensor(idx, torch.ones(int(m.sum())), [user_size, E]).coalesce()
+        graph_list[time_sorted[x]] = A
+    return [graph_list, torch.tensor(root_list)]

